# PayPal sandbox app (developer.paypal.com > Apps & Credentials > Sandbox)
# Leave blank to run in simulation mode.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# One AI provider. Free options: GROQ_API_KEY (console.groq.com) or
# GOOGLE_GENERATIVE_AI_API_KEY (aistudio.google.com). Leave all blank for the offline planner.
GROQ_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Public URL of this app (used in links sent to clients)
APP_URL=http://localhost:3000

# Freelancer profile shown on invoices and in the portal
FREELANCER_NAME=Ada Okafor
FREELANCER_EMAIL=ada@example.com
AI_MODEL=

# Password for the freelancer dashboard. Leave blank locally; set it when deployed.
OWNER_PASSWORD=
