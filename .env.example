# PayPal sandbox app (developer.paypal.com > Apps & Credentials > Sandbox)
# Leave blank to run in simulation mode.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# One AI provider. Free options: GROQ_API_KEY (console.groq.com) or
# GOOGLE_GENERATIVE_AI_API_KEY (aistudio.google.com). Leave all blank for the offline planner.
GROQ_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Public URL of this app (used in links sent to clients)
APP_URL=http://localhost:3000

AI_MODEL=

# Freelancer accounts. Sign-up with email and password always works.
# Sessions are signed with SESSION_SECRET (a long random string). Leave blank locally
# and one is created in data/.session-secret.
SESSION_SECRET=

# "Continue with Google": create an OAuth client (Web application) in Google Cloud Console
# > APIs & Services > Credentials. Authorised redirect URI: APP_URL/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# "Continue with PayPal": tick "Log in with PayPal" on your PayPal app (Apps & Credentials
# > your app > Features), set its Return URL to APP_URL/api/auth/paypal/callback, tick
# Email and Full name under Advanced settings, then set PAYPAL_LOGIN=on.
# If PayPal rejects localhost, use http://127.0.0.1:3000 for both APP_URL and the Return URL.
PAYPAL_LOGIN=off
PAYPAL_RETURN_URL=

# "Try the demo" on the sign-in page opens the seeded demo account. Set to off to hide it.
DEMO_LOGIN=on
